{
  "name": "ridge-inlay",
  "version": "1.0.0",
  "description": "RidgeInlay \u2014 Fleet maintenance logs.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.1.38",
  "engines": {
    "node": "21.x"
  },
  "scripts": {
    "build": "vite build --config vite.config.cjs",
    "test": "mocha --recursive tests",
    "lint": "eslint packages tests eslint-rules --ignore-pattern dist",
    "dup": "jscpd src packages",
    "mutate": "stryker run"
  },
  "devDependencies": {
    "mocha": "10.2.0",
    "jscpd": "3.5.10",
    "eslint": "8.57.1",
    "eslint-plugin-security": "1.7.1",
    "@stryker-mutator/core": "8.7.1",
    "@stryker-mutator/mocha-runner": "8.7.1",
    "vite": "5.4.11"
  },
  "workspaces": [
    "packages/*"
  ]
}
