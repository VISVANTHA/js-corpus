{
  "name": "orchard-hearth",
  "version": "1.0.0",
  "description": "OrchardHearth \u2014 Archive box indexes.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.1.38",
  "engines": {
    "node": "18.x"
  },
  "scripts": {
    "build": "parcel build src/index.js --dist-dir dist --no-source-maps",
    "test": "nyc mocha --recursive tests",
    "lint": "eslint src tests eslint-rules --ignore-pattern dist || eslint . --ignore-pattern dist --ignore-pattern node_modules",
    "dup": "jscpd src packages",
    "mutate": "stryker run"
  },
  "devDependencies": {
    "mocha": "10.2.0",
    "nyc": "15.1.0",
    "jscpd": "3.5.10",
    "eslint": "8.57.1",
    "eslint-plugin-security": "1.7.1",
    "@stryker-mutator/core": "6.4.2",
    "@stryker-mutator/mocha-runner": "6.4.2",
    "parcel": "2.12.0"
  },
  "source": "src/index.js"
}
