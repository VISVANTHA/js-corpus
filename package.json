{
  "name": "vale-hearth",
  "version": "1.0.0",
  "description": "ValeHearth \u2014 Archive box indexes.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.1.38",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "vite build --config vite.config.cjs",
    "test": "nyc mocha --recursive tests",
    "lint": "eslint src tests eslint-rules --ignore-pattern dist || eslint . --ignore-pattern dist --ignore-pattern node_modules",
    "dup": "jscpd src packages"
  },
  "devDependencies": {
    "mocha": "10.2.0",
    "nyc": "17.1.0",
    "jscpd": "3.5.10",
    "eslint": "8.57.1",
    "eslint-plugin-security": "1.7.1",
    "eslint-plugin-sonarjs": "0.25.1",
    "eslint-scope": "7.2.2",
    "vite": "5.4.11"
  }
}
