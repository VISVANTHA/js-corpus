{
  "name": "vale-meadow",
  "version": "1.0.0",
  "description": "ValeMeadow \u2014 Harbor slip bookings.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "yarn@3.6.4",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "node esbuild.config.cjs",
    "test": "nyc mocha --recursive tests",
    "lint": "eslint src tests eslint-rules --ignore-pattern dist || eslint . --ignore-pattern dist --ignore-pattern node_modules",
    "dup": "jscpd src packages"
  },
  "devDependencies": {
    "mocha": "10.2.0",
    "nyc": "17.1.0",
    "jscpd": "3.5.10",
    "eslint": "8.57.1",
    "eslint-plugin-security": "1.7.1",
    "eslint-plugin-sonarjs": "0.25.1",
    "eslint-scope": "7.2.2",
    "esbuild": "0.24.2"
  }
}
