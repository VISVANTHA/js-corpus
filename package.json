{
  "name": "zephyr-compass",
  "version": "1.0.0",
  "description": "ZephyrCompass \u2014 Co-op produce shares.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "swc src -d dist",
    "test": "nyc mocha --recursive tests",
    "lint": "eslint packages tests eslint-rules --ignore-pattern dist",
    "dup": "jscpd src packages"
  },
  "devDependencies": {
    "mocha": "10.2.0",
    "nyc": "17.1.0",
    "jscpd": "3.5.10",
    "eslint": "8.57.1",
    "eslint-plugin-security": "1.7.1",
    "eslint-plugin-sonarjs": "0.25.1",
    "eslint-scope": "7.2.2",
    "@swc/core": "1.9.3",
    "@swc/cli": "0.5.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
