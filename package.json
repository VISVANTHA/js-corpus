{
  "name": "nimbus-mill",
  "version": "1.0.0",
  "description": "NimbusMill \u2014 Community garden plots.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "npm@9.8.1",
  "engines": {
    "node": "18.x"
  },
  "scripts": {
    "build": "webpack --config webpack.config.cjs --mode production",
    "test": "nyc mocha --recursive tests",
    "lint": "eslint src tests eslint-rules --ignore-pattern dist || eslint . --ignore-pattern dist --ignore-pattern node_modules",
    "dup": "jscpd src packages",
    "mutate": "stryker run"
  },
  "devDependencies": {
    "mocha": "10.2.0",
    "nyc": "15.1.0",
    "jscpd": "3.5.10",
    "eslint": "8.57.1",
    "eslint-plugin-security": "1.7.1",
    "@stryker-mutator/core": "6.4.2",
    "@stryker-mutator/mocha-runner": "6.4.2",
    "webpack": "5.97.1",
    "webpack-cli": "5.1.4"
  }
}
