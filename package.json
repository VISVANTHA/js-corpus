{
  "name": "thorn-vault",
  "version": "1.0.0",
  "description": "ThornVault \u2014 Workshop tool lending.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "21.x"
  },
  "scripts": {
    "build": "rspack build --config rspack.config.cjs",
    "test": "mocha --recursive tests",
    "lint": "eslint packages tests eslint-rules --ignore-pattern dist",
    "dup": "jscpd src packages",
    "mutate": "stryker run"
  },
  "devDependencies": {
    "mocha": "10.2.0",
    "jscpd": "3.5.10",
    "eslint": "8.57.1",
    "eslint-plugin-security": "1.7.1",
    "@stryker-mutator/core": "8.7.1",
    "@stryker-mutator/mocha-runner": "8.7.1",
    "@rspack/core": "0.5.9",
    "@rspack/cli": "0.5.9"
  },
  "workspaces": [
    "packages/*"
  ]
}
