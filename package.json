{
  "name": "thorn-meadow",
  "version": "1.0.0",
  "description": "ThornMeadow \u2014 Harbor slip bookings.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "yarn@3.6.4",
  "engines": {
    "node": "21.x"
  },
  "scripts": {
    "build": "rspack build --config rspack.config.cjs",
    "test": "mocha --recursive tests",
    "lint": "eslint src tests eslint-rules --ignore-pattern dist || eslint . --ignore-pattern dist --ignore-pattern node_modules",
    "dup": "jscpd src packages",
    "mutate": "stryker run"
  },
  "devDependencies": {
    "mocha": "10.2.0",
    "jscpd": "3.5.10",
    "eslint": "8.57.1",
    "eslint-plugin-security": "1.7.1",
    "@stryker-mutator/core": "8.7.1",
    "@stryker-mutator/mocha-runner": "8.7.1",
    "@rspack/core": "0.5.9",
    "@rspack/cli": "0.5.9"
  }
}
