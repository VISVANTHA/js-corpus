{
  "name": "nimbus-marina",
  "version": "1.0.0",
  "description": "NimbusMarina \u2014 Maker-space access.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "yarn@3.6.4",
  "engines": {
    "node": "18.x"
  },
  "scripts": {
    "build": "rollup -c rollup.config.cjs",
    "test": "nyc mocha --recursive tests",
    "lint": "eslint packages tests eslint-rules --ignore-pattern dist",
    "dup": "jscpd src packages",
    "mutate": "stryker run"
  },
  "devDependencies": {
    "mocha": "10.2.0",
    "nyc": "15.1.0",
    "jscpd": "3.5.10",
    "eslint": "8.57.1",
    "eslint-plugin-security": "1.7.1",
    "@stryker-mutator/core": "6.4.2",
    "@stryker-mutator/mocha-runner": "6.4.2",
    "rollup": "3.29.4"
  },
  "workspaces": [
    "packages/*"
  ]
}
