{
  "name": "orchard-fen",
  "version": "1.0.0",
  "description": "OrchardFen \u2014 Clinic intake queues.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": "18.x"
  },
  "scripts": {
    "build": "parcel build packages/api/src/index.js --dist-dir dist --no-source-maps",
    "test": "nyc mocha --recursive tests",
    "lint": "eslint packages tests eslint-rules --ignore-pattern dist",
    "dup": "jscpd src packages",
    "mutate": "stryker run"
  },
  "devDependencies": {
    "mocha": "10.2.0",
    "nyc": "15.1.0",
    "jscpd": "3.5.10",
    "eslint": "8.57.1",
    "eslint-plugin-security": "1.7.1",
    "@stryker-mutator/core": "6.4.2",
    "@stryker-mutator/mocha-runner": "6.4.2",
    "parcel": "2.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "source": "packages/api/src/index.js"
}
