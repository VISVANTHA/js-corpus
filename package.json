{
  "name": "vale-terrace",
  "version": "1.0.0",
  "description": "ValeTerrace \u2014 Studio kiln schedules.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.1.38",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "node esbuild.config.cjs",
    "test": "nyc mocha --recursive tests",
    "lint": "eslint packages tests eslint-rules --ignore-pattern dist",
    "dup": "jscpd src packages"
  },
  "devDependencies": {
    "mocha": "10.2.0",
    "nyc": "17.1.0",
    "jscpd": "3.5.10",
    "eslint": "8.57.1",
    "eslint-plugin-security": "1.7.1",
    "eslint-plugin-sonarjs": "0.25.1",
    "eslint-scope": "7.2.2",
    "esbuild": "0.24.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
