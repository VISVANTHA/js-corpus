{
  "name": "sage-quarry",
  "version": "1.0.0",
  "description": "SageQuarry \u2014 Trail permit desks.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.1.38",
  "engines": {
    "node": "21.x"
  },
  "scripts": {
    "build": "webpack --config webpack.config.cjs --mode production",
    "test": "mocha --recursive tests",
    "lint": "eslint src tests eslint-rules --ignore-pattern dist || eslint . --ignore-pattern dist --ignore-pattern node_modules",
    "dup": "jscpd src packages",
    "mutate": "stryker run"
  },
  "devDependencies": {
    "mocha": "10.2.0",
    "jscpd": "3.5.10",
    "eslint": "8.57.1",
    "eslint-plugin-security": "1.7.1",
    "@stryker-mutator/core": "8.7.1",
    "@stryker-mutator/mocha-runner": "8.7.1",
    "webpack": "5.97.1",
    "webpack-cli": "5.1.4"
  }
}
